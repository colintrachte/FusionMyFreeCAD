# FusionMyFreeCAD repository ignores
#
# Keep source layouts, manifests, icons, vendored runtime snapshots, and licenses
# under version control. Ignore only reproducible output, caches, machine-local
# state, and editor/OS noise.

# Python bytecode and tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Full upstream addon checkouts are reference/update inputs only. The curated,
# release-ready runtime payload lives in /bundled-addons/ and is tracked.
/vendor/
# Python environments and local package state
.venv/
venv/
env/
ENV/
__pypackages__/
.pdm-python
.pdm-build/
.pixi/
*.egg-info/
.eggs/

# Python packaging output
build/
dist/
wheels/
*.egg
*.whl
.installed.cfg

# FreeCAD machine-local profile, runtime state, and recovery files
/user.cfg
/system.cfg
/RibbonUI_Data/
/FusionMyFreeCAD-addon-state.json
/FusionMyFreeCAD-runtime-status.json
/FusionMyFreeCAD-usage.json
*.FCBak
*.FCStd1

# Logs, temporary files, and local secrets
*.log
*.tmp
*.temp
*.swp
*.swo
*~
.env
.env.*
!.env.example

# Machine-local dev helper state (tools/install-dev.ps1)
/.install-dev.local.json

# Editors and operating systems
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
Desktop.ini

# Notebook and documentation build caches
.ipynb_checkpoints/
docs/_build/
site/

# Local scratch directories
.cache/
tmp/
temp/
